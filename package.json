{
  "name": "abap-package-version-shield",
  "version": "1.1.0",
  "description": "Custom handler for shields.io to display abap package version",
  "author": "Alexander Tsybulsky",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/sbcgua/abap-package-version-shield.git"
  },
  "homepage": "https://sbcgua.github.io/abap-package-version-shield",
  "type": "module",
  "exports": "./src/handler.js",
  "scripts": {
    "build-esbuild": "esbuild src/handler.js --bundle --platform=node --format=esm --tree-shaking=true --outfile=dist/out.js",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:e2e": "env E2E_TARGET=prod vitest run",
    "test:e2e:dev": "env E2E_TARGET=dev vitest run",
    "test:e2e:qa": "env E2E_TARGET=qa vitest run",
    "lint": "eslint",
    "lint:wlist": "env DEBUG=eslint:eslint eslint",
    "deploy:prod": "bash ./bin/deploy-prod.sh",
    "deploy:qa": "bash ./bin/deploy-qa.sh",
    "deploy:dev": "bash ./bin/deploy-dev.sh",
    "shutdown:qa": "bash ./bin/remove-qa.sh",
    "shutdown:dev": "bash ./bin/remove-dev.sh",
    "logs": "serverless logs -f getAbapVersionShieldJson --stage dev -t",
    "info:dev": "serverless info --stage dev",
    "info:prod": "serverless info --stage prod"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.2.1",
    "esbuild": "^0.25.8",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "serverless": "^4.18.0",
    "serverless-domain-manager": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "lodash-es": "^4.17.23"
  }
}
